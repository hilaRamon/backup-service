# Schedule (UTC). Default: daily at 02:00.
BACKUP_CRON=0 2 * * *

# Storage
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=backups

# Per-site MongoDB URIs (names must match uriEnv in config/sites/*.ts)
BAGROT_MONGODB_URI=
SIDURAVODA_MONGODB_URI=
GADASH_MONGODB_URI=
