{
  "name": "backup-service",
  "version": "1.0.0",
  "description": "Standalone MongoDB Atlas backup worker for multiple sites, storing archives in Cloudflare R2",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "backup": "tsx src/index.ts backup",
    "backup-all": "tsx src/index.ts backup-all",
    "retention": "tsx src/index.ts retention",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
